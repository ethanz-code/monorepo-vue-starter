#!/bin/sh

# 检查是否通过允许的方式提交
if [ -z "$BYPASS_PRECOMMIT" ]; then
  echo "⚠️ 直接使用 git commit 是不被允许的！"
  echo ""
  echo "请使用以下命令之一进行提交："
  echo "  📦 bun run commit        - 交互式提交"
  echo "  🔍 bun run commit:check  - 标准化检查后提交"
  echo ""
  echo "如果你确实需要绕过此限制，请使用："
  echo "  BYPASS_PRECOMMIT=1 git commit ..."
  echo ""
  exit 1
fi

echo "✔️ 通过预提交检查"