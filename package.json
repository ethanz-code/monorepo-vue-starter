{
  "name": "@monorepo-vue-starter/root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "standardize": "run-s type-check lint format",
    "commit": "BYPASS_PRECOMMIT=1 cz",
    "commit:check": "run-s standardize commit"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "workspaces": ["packages/*"],
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "lucide-vue-next": "^0.562.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/cz-commitlint": "^20.3.1",
    "@ethan-utils/axios": "^2.6.0",
    "@ethan-utils/pinia": "^1.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "code-inspector-plugin": "^1.3.5",
    "commitizen": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.39.0",
    "eslint-plugin-vue": "~10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lodash-es": "^4.17.22",
    "npm-run-all2": "^8.0.4",
    "onchange": "^7.1.0",
    "oxlint": "^1.39.0",
    "prettier": "3.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vue-tsc": "^3.2.2"
  }
}
